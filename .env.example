# Copy to `.env` and fill in. Never commit `.env`.
#
# VITE_* vars are inlined into the client bundle and are public.
# Everything else stays server-side (Vercel → Project Settings → Environment
# Variables, and locally in `.env` for `npm run dev`).

# --- Telegram (required for the contact form) ------------------------------
# Create a bot with @BotFather, then get the chat id by messaging the bot and
# opening https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- reCAPTCHA v3 (optional) ----------------------------------------------
# https://www.google.com/recaptcha/admin — register a v3 site key.
# Both must be set for verification to happen. If either is missing the form
# still works, just without scoring.
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
